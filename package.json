{
  "name": "ausbildungszentrale",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:cloudflare": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ausbildungszentrale --local",
    "db:migrate:remote": "wrangler d1 migrations apply ausbildungszentrale --remote"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@vitejs/plugin-react": "^5.0.4",
    "hono": "^4.9.8",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
